# GEEX storefront production environment.
# Configure these in your deployment platform. Do not commit real secrets.

NEXT_PUBLIC_BASE_URL=https://www.geexfans.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.geexfans.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=replace_with_medusa_publishable_key
NEXT_PUBLIC_MEDUSA_SALES_CHANNEL_ID=replace_with_medusa_sales_channel_id

NEXT_PUBLIC_STRIPE_KEY=replace_with_stripe_publishable_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key

NEXT_PUBLIC_SUPPORT_EMAIL=support@geexfans.com
NEXT_PUBLIC_COMPANY_LEGAL_NAME=replace_with_legal_company_name
NEXT_PUBLIC_COMPANY_REG_NO=replace_with_company_registration_number
NEXT_PUBLIC_COMPANY_ADDRESS=replace_with_registered_company_address
NEXT_PUBLIC_SOCIAL_LINKS=
NEXT_PUBLIC_IMAGE_DOMAINS=images.unsplash.com,videos.pexels.com,assets.geexfans.com

# Optional CMS. Leave empty to disable dynamic Journal fetches.
STRAPI_API_URL=
STRAPI_API_TOKEN=

# Optional AI assistant.
NEXT_PUBLIC_GEMINI_API_KEY=
